# Copy this file to ".env" and fill in your values.
# The real .env is gitignored and never committed.

# --- LLM (optional) ---
# Without a key, Sutros still runs using its rule-based fallback:
# the orchestrator runs every check and the report uses built-in plain-language
# templates. Add a key to turn on the smart planner and natural-language write-up.
OPENAI_API_KEY=

# Which model to use for the orchestrator and report writer.
OPENAI_MODEL=gpt-4o-mini

# --- Database (optional) ---
# When set, every checkup is saved and gets a shareable link (/r/<id>).
# Example: postgres://porchlight:password@localhost:5432/porchlight
DATABASE_URL=

# --- Server ---
PORT=3000

# --- Scan limits (safe defaults; raise only for sites you own) ---
# Max links/images sampled for the broken-link check.
MAX_LINKS=20
# Per-request timeout in milliseconds.
REQUEST_TIMEOUT_MS=8000

# --- Accounts ---
# 1 = a confirmed account is required to run a checkup. 0 (default) = anyone can run one;
# anonymous checkups are paced per connection and share a global ceiling.
REQUIRE_ACCOUNT=0

# --- Browser (optional) ---
# Where the visitor simulation, the page pictures, and the browsing agent get a Chrome.
# Leave everything empty to use Playwright's local Chromium (npm run enable-browser).
# A hosted Chrome that speaks the DevTools protocol (Browserless, Steel, Hyperbrowser, a
# self-hosted browserless container), for example wss://production-sfo.browserless.io?token=...
BROWSER_WS_ENDPOINT=
# "cdp" (default) or "playwright" for hosts that expose Playwright's own /playwright endpoint.
BROWSER_CONNECT=cdp
# Or Browserbase: one isolated session per checkup with a replay link.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# --- Browsing agent (optional, needs OPENAI_API_KEY and a browser) ---
# 0 turns off the LLM-driven visitor that explores the site read-only.
AGENT_BROWSE=1
AGENT_STEPS=12
AGENT_BUDGET_MS=90000
